# Postgres connection string. Chirpy migrates the schema automatically on startup.
DB_URL=postgres://user:password@localhost:5432/chirpy

# Port the Express server listens on.
PORT=8080

# "dev" enables developer-only routes (e.g. POST /admin/reset, which wipes all users).
# Use anything else (e.g. "prod") to lock those routes down.
PLATFORM=dev

# Secret used to sign/verify JWT access tokens. Generate one with:
#   openssl rand -base64 64
SECRET=changeme

# Shared secret Polka must send as a Bearer token when calling POST /api/polka/webhooks.
POLKA_KEY=changeme
